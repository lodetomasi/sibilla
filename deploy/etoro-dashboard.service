[Unit]
Description=SIBILLA eToro dashboard (read-only, 127.0.0.1:8000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ats
WorkingDirectory=/home/ats/automatic-trading-bot
ExecStart=/home/ats/automatic-trading-bot/scripts/serve_etoro_dashboard.sh
Restart=always
RestartSec=10
StandardOutput=append:/home/ats/automatic-trading-bot/data/etoro_dashboard.log
StandardError=append:/home/ats/automatic-trading-bot/data/etoro_dashboard.log

[Install]
WantedBy=multi-user.target
