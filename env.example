# SIBILLA — example environment. Copy to .env and fill in. NEVER commit .env.

# LLM (OpenRouter)
ATS_OPENROUTER_API_KEY=sk-or-REPLACE_ME

# Execution mode: SHADOW | PAPER | DEMO | LIVE_SMALL | LIVE
# Demo/real per eToro e' derivato da questo, non da un env separato.
ATS_EXECUTION_MODE=PAPER

# Database (sqlite by default)
ATS_DATABASE_URL=sqlite+aiosqlite:///./data/ats.db

# eToro (public-api.etoro.com) — Settings -> Trading -> API Key Management
ATS_ETORO_API_KEY=
ATS_ETORO_USER_KEY=
