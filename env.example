# SIBILLA — example environment. Copy to .env and fill in. NEVER commit .env.

# LLM (OpenRouter)
ATS_OPENROUTER_API_KEY=sk-or-REPLACE_ME

# Execution mode: SHADOW | PAPER (paper mirror; live orders are gated separately)
ATS_EXECUTION_MODE=PAPER

# Database (sqlite by default)
ATS_DATABASE_URL=sqlite+aiosqlite:///./data/ats.db

# Limitless Exchange (Base) — live trading path
ATS_LIMITLESS_ENABLED=1
ATS_LIMITLESS_LIVE=0                # 1 = real on-chain orders
ATS_LIMITLESS_ONCHAIN=1
ATS_LIMITLESS_MAKER=0               # complete-set maker probe
ATS_LIMITLESS_LIVE_MAX_USDC=5       # hard cap per live order
ATS_LIMITLESS_API_KEY=REPLACE_ME
ATS_LIMITLESS_API_SECRET=REPLACE_ME
ATS_LIMITLESS_CLOB_API_KEY=REPLACE_ME
ATS_LIMITLESS_CLOB_API_SECRET=REPLACE_ME
ATS_LIMITLESS_PRIVATE_KEY=0xREPLACE_ME   # EOA private key — keep it safe
ATS_LIMITLESS_WALLET_ADDRESS=0xREPLACE_ME

# Bankroll fallback (normally read on-chain at boot by the supervisor)
ATS_BANKROLL=10
